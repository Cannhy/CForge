# ---------------------------------------------------------------------------
# CForge environment variables
# Copy this file to `.env` and fill in the values for whichever services you
# plan to use. Variables you do not need can be left blank.
# ---------------------------------------------------------------------------

# ---- HuggingFace ----------------------------------------------------------
# Needed to (a) pull gated datasets / models, and (b) upload artifacts.
# Create at https://huggingface.co/settings/tokens  (read or write scope).
HF_TOKEN=

# ---- Volcengine Ark (Doubao / DeepSeek hosted) ----------------------------
DOUBAO_API_KEY=
DOUBAO_BASE_URL=
DOUBAO_ENDPOINT_32K=
DOUBAO_ENDPOINT_256K=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_ENDPOINT_V3=
DEEPSEEK_ENDPOINT_R1=

# ---- Local paths (optional) -----------------------------------------------
# Override data / cache paths if you keep them outside the repo.
# BENCHC_DATA_ROOT=/path/to/CForge_data/data
# APPS_TRAIN_PARQUET=/path/to/apps_train/train.parquet
